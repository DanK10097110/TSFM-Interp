# Python cache files
__pycache__/
*.py[cod]
*$py.class

# JSON files
*.json
*.jsonl
!.zenodo.json

# Virtual environments and package builds
venv/
.env
*.egg-info/
dist/
build/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Debug logs (run_validation.py --debug, etc.)
/logs/

# Data files (scientific computing formats)
*.parquet
*.npz
*.npy
*.pkl
*.pickle
*.pt
*.pth
*.h5
*.hdf5
*.feather
*.zarr/

# Cache and testing
.pytest_cache/
.mypy_cache/

# Generated run outputs and intermediate data
runs/
tsfm_lens/runs/
tsfm_benchmark/outputs/

tsfm_lens/.pytest_tmp/

# Committed validation-report output directories moved to DEV-ONLY (Spec B):
# regenerate with example_runs/run_validation.py --corpus <dir> --out <name>/
outputs_full*/
validation_*/
benchmark_run*_validation/

# Sealed benchmark corpora (untracked; build with example_runs/run_full.py)
benchmark_large*/
benchmark_v3/
benchmark_medium/
benchmark_out/

# Claude Code local state
.claude/settings*.json
.claude/worktrees/

# Misc runtime/log artifacts
*.pid
*.log
.ipynb_checkpoints/
# The published example run ships its lightweight JSON/parquet artifacts on purpose
!examples/**/
!examples/**/*.json
!examples/**/*.parquet
